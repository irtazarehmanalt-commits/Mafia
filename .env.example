# ---------------------------------------------------------------------------
# Copy to .env (root, for docker-compose) and/or apps/server/.env + apps/web/.env.local
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Postgres connection string. If omitted the server runs in EPHEMERAL mode:
# fully playable, but rooms are lost on restart.
DATABASE_URL="postgresql://mafia:mafia@localhost:5432/mafia?schema=public"

# --- Redis ------------------------------------------------------------------
# Enables the Socket.IO Redis adapter (multi-instance fan-out) and shared room
# state. If omitted the server uses a single-instance in-memory adapter.
REDIS_URL="redis://localhost:6379"

# --- Security ---------------------------------------------------------------
# HMAC key used to sign player session tokens. MUST be changed in production.
# Generate with: openssl rand -base64 48
AUTH_SECRET="dev-only-insecure-secret-change-me-in-production"

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (CORS + Socket.IO)
CORS_ORIGIN="http://localhost:3000"
LOG_LEVEL=info

# --- Web (Next.js) ----------------------------------------------------------
# Public base URL of the web app, used to build shareable invite links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Public URL of the Socket.IO / REST game server.
NEXT_PUBLIC_SOCKET_SERVER_URL="http://localhost:4000"
